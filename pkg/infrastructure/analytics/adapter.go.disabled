package analytics

import (
	"context"
	"time"

	"github.com/ethpandaops/pandafuzz/pkg/application/analytics"
	"github.com/ethpandaops/pandafuzz/pkg/common"
	"github.com/ethpandaops/pandafuzz/pkg/infrastructure/storage/abstraction"
	"github.com/ethpandaops/pandafuzz/pkg/service"
	"github.com/sirupsen/logrus"
)

// ServiceAdapter adapts storage and services to analytics interfaces
type ServiceAdapter struct {
	storage         abstraction.Driver
	jobService      service.JobService
	campaignService service.CampaignService
	logger          logrus.FieldLogger
}

// NewServiceAdapter creates a new service adapter
func NewServiceAdapter(
	storage abstraction.Driver,
	jobService service.JobService,
	campaignService service.CampaignService,
	logger logrus.FieldLogger,
) *ServiceAdapter {
	return &ServiceAdapter{
		storage:         storage,
		jobService:      jobService,
		campaignService: campaignService,
		logger:          logger.WithField("component", "analytics_adapter"),
	}
}

