// Implement analytics.JobProvider interface

// GetJob retrieves a job by ID
func (s *ServiceAdapter) GetJob(ctx context.Context, jobID string) (*common.Job, error) {
	return s.jobService.GetJob(ctx, jobID)
}

// ListJobs lists jobs with filtering
func (s *ServiceAdapter) ListJobs(ctx context.Context, filter analytics.JobFilter) ([]*common.Job, error) {
	// Convert analytics.JobFilter to service.JobFilter
	serviceFilter := service.JobFilter{
		CampaignID: filter.CampaignID,
		Status:     filter.Status,
		Limit:      filter.Limit,
		Offset:     filter.Offset,
	}

	if filter.CreatedAfter != nil {
		serviceFilter.CreatedAfter = *filter.CreatedAfter
	}

	if filter.CreatedBefore != nil {
		serviceFilter.CreatedBefore = *filter.CreatedBefore
	}

	return s.jobService.ListJobs(ctx, serviceFilter)
}

// GetJobStats retrieves job statistics
func (s *ServiceAdapter) GetJobStats(ctx context.Context, jobID string) (*service.JobStats, error) {
	return s.jobService.GetJobStats(ctx, jobID)
}

// Implement analytics.CampaignProvider interface

// GetCampaign retrieves a campaign by ID
func (s *ServiceAdapter) GetCampaign(ctx context.Context, campaignID string) (*common.Campaign, error) {
	return s.campaignService.Get(ctx, campaignID)
}

// ListCampaigns lists campaigns with filtering
func (s *ServiceAdapter) ListCampaigns(ctx context.Context, filter analytics.CampaignFilter) ([]*common.Campaign, error) {
	// Convert analytics.CampaignFilter to common.CampaignFilters
	commonFilter := common.CampaignFilters{
		Status:     filter.Status,
		BinaryHash: filter.BinaryHash,
		Tags:       filter.Tags,
		Limit:      filter.Limit,
		Offset:     filter.Offset,
	}

	return s.campaignService.List(ctx, commonFilter)
}

// GetCampaignStats retrieves campaign statistics
func (s *ServiceAdapter) GetCampaignStats(ctx context.Context, campaignID string) (*common.CampaignStats, error) {
	return s.campaignService.GetStatistics(ctx, campaignID)
}

