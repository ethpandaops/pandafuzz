package v1

import (
	"context"
	"net/http"
	"time"

	"github.com/ethpandaops/pandafuzz/pkg/common"
	"github.com/ethpandaops/pandafuzz/pkg/service"
	"github.com/gorilla/mux"
	"github.com/sirupsen/logrus"
)

// ExampleIntegration shows how to integrate the V1 API into the main server
func ExampleIntegration() {
	// Create logger
	logger := logrus.New()

	// Create mock services (in production, these would be real implementations)
	botService := &mockBotService{}
	jobService := &mockJobService{}
	resultService := &mockResultService{}
	campaignService := &mockCampaignService{}
	corpusService := &mockCorpusService{}
	storage := &mockStorage{}

	// Create router configuration
	config := &RouterConfig{
		BotService:      botService,
		JobService:      jobService,
		ResultService:   resultService,
		CampaignService: campaignService,
		CorpusService:   corpusService,
		Storage:         storage,
		Logger:          logger,
		EnableCORS:      true,
		AllowedOrigins:  []string{"*"},
		RequestTimeout:  "30s",
	}

	// Create V1 router
	v1Router := NewRouter(config)

	// Create main router
	mainRouter := mux.NewRouter()

	// Mount V1 API at /api/v1
	apiV1 := mainRouter.PathPrefix("/api/v1").Subrouter()
	v1Router.SetupRoutes(apiV1)

	// Start server
	server := &http.Server{
		Addr:         ":8080",
		Handler:      mainRouter,
		ReadTimeout:  15 * time.Second,
		WriteTimeout: 15 * time.Second,
	}

	logger.Info("Starting server on :8080")
	if err := server.ListenAndServe(); err != nil {
		logger.WithError(err).Fatal("Server failed to start")
	}
}

// Mock service implementations for example

type mockBotService struct{}

func (m *mockBotService) Start(ctx context.Context) error { return nil }
func (m *mockBotService) Stop() error                     { return nil }
func (m *mockBotService) RegisterBot(ctx context.Context, hostname string, name string, capabilities []string, apiEndpoint string) (*common.Bot, error) {
	return &common.Bot{
		ID:           generateID(),
		Hostname:     hostname,
		Name:         name,
		Capabilities: capabilities,
		APIEndpoint:  apiEndpoint,
		RegisteredAt: time.Now(),
		TimeoutAt:    time.Now().Add(30 * time.Second),
		Status:       common.BotStatusIdle,
		IsOnline:     true,
	}, nil
}
