	"github.com/prometheus/client_golang/prometheus"
	"github.com/sirupsen/logrus"
)

// ExampleIntegration shows how to integrate the V2 API into your application
func ExampleIntegration() {
	// Create logger
	logger := logrus.New()
	logger.SetLevel(logrus.DebugLevel)

	// Create services (in production, these would be real implementations)
	botService := createMockBotService()
	jobService := createMockJobService()
	campaignService := createMockCampaignService()
	resultService := createMockResultService()
	corpusService := createMockCorpusService()
	storage := createMockStorage()

	// Create Prometheus registry
	promRegistry := prometheus.NewRegistry()

	// Create V2 router configuration
	config := &RouterConfig{
		// Services
		BotService:      botService,
		JobService:      jobService,
		CampaignService: campaignService,
		ResultService:   resultService,
		CorpusService:   corpusService,
		Storage:         storage,

		// Logger
		Logger: logger,

		// Middleware configuration
		EnableCORS:      true,
		AllowedOrigins:  []string{"*"},
		EnableMetrics:   true,
		EnableRateLimit: true,
		RateLimitPerMin: 60,

		// Timeouts
		RequestTimeout: "30s",
		ReadTimeout:    15 * time.Second,
		WriteTimeout:   15 * time.Second,

		// Circuit breaker
		CircuitBreakerEnabled:     true,
		CircuitBreakerThreshold:   0.5,
		CircuitBreakerMaxRequests: 100,

		// Prometheus
		PrometheusRegistry: promRegistry,
	}

	// Create V2 router
	v2Router := NewRouter(config)

	// Create main router
	mainRouter := mux.NewRouter()

	// Mount V2 API at /api/v2
	apiV2 := mainRouter.PathPrefix("/api/v2").Subrouter()
	v2Router.SetupRoutes(apiV2)

	// Add Prometheus metrics endpoint
	mainRouter.Handle("/metrics", prometheus.Handler())

	// Create HTTP server
	server := &http.Server{
		Addr:         ":8080",
		Handler:      mainRouter,
		ReadTimeout:  15 * time.Second,
		WriteTimeout: 15 * time.Second,
		IdleTimeout:  120 * time.Second,
	}

	// Start services
	ctx := context.Background()
	if err := botService.Start(ctx); err != nil {
		log.Fatal("Failed to start bot service:", err)
	}
	if err := jobService.Start(ctx); err != nil {
		log.Fatal("Failed to start job service:", err)
	}

	// Start server
	logger.Info("Starting V2 API server on :8080")
	logger.Info("API documentation available at http://localhost:8080/api/v2/swagger/")
	logger.Info("Metrics available at http://localhost:8080/metrics")

	if err := server.ListenAndServe(); err != nil {
		logger.WithError(err).Fatal("Server failed to start")
	}
}

// ExampleMigrationFromV1 shows how to migrate from V1 to V2
func ExampleMigrationFromV1() {
	logger := logrus.New()

	// V1 style request
	// GET /api/v1/campaigns?limit=10&offset=0

	// V2 style request with enhanced features
	// GET /api/v2/campaigns?page=1&page_size=10&sort=created_at&order=desc&status=active&tags=security,fuzz

	// Key differences:
	// 1. Pagination: V2 uses page/page_size instead of limit/offset
	// 2. Filtering: V2 supports advanced filtering by status, tags, binary hash, etc.
	// 3. Sorting: V2 supports sorting by multiple fields
	// 4. Response format: V2 includes metadata and pagination info
	// 5. Error handling: V2 uses structured error responses with error codes

	logger.Info("V2 API provides enhanced features while maintaining backward compatibility")
}

