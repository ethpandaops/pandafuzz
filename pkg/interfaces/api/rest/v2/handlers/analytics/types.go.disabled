package analytics

import (
	"errors"
	"time"
)

// Common errors
var (
	ErrCampaignNotFound = errors.New("campaign not found")
)

// CoverageFilter represents filters for coverage queries
type CoverageFilter struct {
	CampaignID string
	JobID      string
	TimeRange  TimeRange
}

// TimeRange represents a time range
type TimeRange struct {
	Start time.Time
	End   time.Time
}

// CoverageTrend represents coverage trend data
type CoverageTrend struct {
	DataPoints []CoverageDataPoint `json:"data_points"`
}

// CoverageDataPoint represents a single coverage data point
type CoverageDataPoint struct {
	Timestamp        time.Time `json:"timestamp"`
	TotalCoverage    float64   `json:"total_coverage"`
	LineCoverage     float64   `json:"line_coverage"`
	FunctionCoverage float64   `json:"function_coverage"`
	BranchCoverage   float64   `json:"branch_coverage"`
}

// CrashFilter represents filters for crash queries
type CrashFilter struct {
	CampaignID string
	JobID      string
	Severity   string
	TimeRange  TimeRange
}

// CrashTimeline represents crash timeline data
type CrashTimeline struct {
	DataPoints []CrashDataPoint `json:"data_points"`
}

// CrashDataPoint represents a single crash data point
type CrashDataPoint struct {
	Timestamp         time.Time      `json:"timestamp"`
	TotalCrashes      int            `json:"total_crashes"`
	UniqueCrashes     int            `json:"unique_crashes"`
	SeverityBreakdown map[string]int `json:"severity_breakdown"`
}
