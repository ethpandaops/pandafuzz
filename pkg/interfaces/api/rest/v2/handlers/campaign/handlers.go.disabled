package campaign

import (
	"encoding/json"
	"net/http"
	"strings"

	"github.com/ethpandaops/pandafuzz/pkg/common"
	"github.com/gorilla/mux"
	"github.com/sirupsen/logrus"
)

// Handler handles campaign-related HTTP requests
type Handler struct {
	campaignService common.CampaignService
	logger          logrus.FieldLogger
	validator       *Validator
}

// NewHandler creates a new campaign handler
func NewHandler(campaignService common.CampaignService, logger logrus.FieldLogger) *Handler {
	return &Handler{
		campaignService: campaignService,
		logger:          logger,
		validator:       NewValidator(),
	}
}

// RegisterRoutes registers campaign routes
func (h *Handler) RegisterRoutes(r *mux.Router) {
	r.HandleFunc("/campaigns", h.CreateCampaign).Methods("POST")
	r.HandleFunc("/campaigns", h.ListCampaigns).Methods("GET")
	r.HandleFunc("/campaigns/{id}", h.GetCampaign).Methods("GET")
	r.HandleFunc("/campaigns/{id}", h.UpdateCampaign).Methods("PATCH")
	r.HandleFunc("/campaigns/{id}", h.DeleteCampaign).Methods("DELETE")
	r.HandleFunc("/campaigns/{id}/restart", h.RestartCampaign).Methods("POST")
	r.HandleFunc("/campaigns/{id}/stats", h.GetCampaignStats).Methods("GET")
	r.HandleFunc("/campaigns/{id}/timeline", h.GetCampaignTimeline).Methods("GET")
	r.HandleFunc("/campaigns/{id}/binary", h.UploadCampaignBinary).Methods("POST")
	r.HandleFunc("/campaigns/{id}/corpus", h.UploadCampaignCorpus).Methods("POST")
}

// CreateCampaign creates a new campaign
// @Summary Create a new fuzzing campaign
// @Description Create a new campaign with the specified configuration
// @Tags campaigns
// @Accept json
// @Produce json
// @Param campaign body CreateCampaignRequest true "Campaign configuration"
// @Success 201 {object} SuccessResponse{data=CampaignResponse}
// @Failure 400 {object} ErrorResponse
// @Failure 500 {object} ErrorResponse
// @Router /api/v2/campaigns [post]
func (h *Handler) CreateCampaign(w http.ResponseWriter, r *http.Request) {
	logger := getLogger(r.Context())

	// Parse request
	var req CreateCampaignRequest
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		writeError(w, http.StatusBadRequest, "INVALID_REQUEST", "Invalid request body", err)
		return
	}

	// Validate request
	if err := h.validator.ValidateStruct(&req); err != nil {
		writeError(w, http.StatusBadRequest, "VALIDATION_FAILED", "Request validation failed", err)
		return
	}

	// Create campaign
	campaign := &common.Campaign{
		Name:         req.Name,
		Description:  req.Description,
		TargetBinary: req.TargetBinary,
		AutoRestart:  req.AutoRestart,
		SharedCorpus: req.SharedCorpus,
		Tags:         req.Tags,
		MaxDuration:  req.MaxDuration,
		MaxJobs:      req.MaxJobs,
		// FuzzerConfig: req.FuzzerConfig, // TODO: Add this field to Campaign struct
	}
	err := h.campaignService.Create(r.Context(), campaign)

	if err != nil {
		logger.WithError(err).Error("Failed to create campaign")
		writeError(w, http.StatusInternalServerError, "CREATE_FAILED", "Failed to create campaign", err)
		return
	}

	// Get statistics
	stats, _ := h.campaignService.GetStatistics(r.Context(), campaign.ID)

	// Build response
	response := &CampaignResponse{
		Campaign:    campaign,
		Statistics:  toCampaignStatistics(stats),
		ActiveJobs:  0,
		TotalJobs:   0,
		HealthScore: 100.0,
	}

	// Broadcast via WebSocket
	h.broadcastCampaignEvent("campaign_created", campaign.ID, nil)

	writeSuccess(w, http.StatusCreated, response, nil, nil)
}

// ListCampaigns lists campaigns with pagination and filtering
// @Summary List campaigns
// @Description Get a list of campaigns with optional filtering and pagination
// @Tags campaigns
// @Accept json
// @Produce json
// @Param page query int false "Page number" default(1)
// @Param page_size query int false "Page size" default(20) maximum(100)
// @Param status query string false "Filter by status"
// @Param binary_hash query string false "Filter by binary hash"
// @Param tags query []string false "Filter by tags"
// @Param search query string false "Search in name and description"
// @Param sort query string false "Sort field" default(created_at)
// @Param order query string false "Sort order" Enums(asc,desc) default(desc)
// @Success 200 {object} SuccessResponse{data=[]CampaignResponse}
// @Failure 400 {object} ErrorResponse
// @Failure 500 {object} ErrorResponse
// @Router /api/v2/campaigns [get]
func (h *Handler) ListCampaigns(w http.ResponseWriter, r *http.Request) {
	logger := getLogger(r.Context())

	// Parse pagination
	pagination, err := parsePaginationParams(r)
	if err != nil {
		writeError(w, http.StatusBadRequest, "INVALID_PAGINATION", "Invalid pagination parameters", err)
		return
	}

	// Parse filters
	filters := common.CampaignFilters{
		Limit:  pagination.PageSize,
		Offset: (pagination.Page - 1) * pagination.PageSize,
	}

	// Parse status filter
	if status := r.URL.Query().Get("status"); status != "" {
		filters.Status = status
	}

	// Parse binary hash filter
	filters.BinaryHash = r.URL.Query().Get("binary_hash")

	// Parse tags filter
	tags, err := validateQueryTags(r)
	if err != nil {
		writeError(w, http.StatusBadRequest, "INVALID_TAGS", "Invalid tags parameter", err)
		return
	}
	filters.Tags = tags

	// Get campaigns
	campaigns, err := h.campaignService.List(r.Context(), filters)
	if err != nil {
		logger.WithError(err).Error("Failed to list campaigns")
		writeError(w, http.StatusInternalServerError, "LIST_FAILED", "Failed to list campaigns", err)
		return
	}

	// Build response list
	responses := make([]*CampaignResponse, len(campaigns))
	for i, campaign := range campaigns {
		stats, _ := h.campaignService.GetStatistics(r.Context(), campaign.ID)
		responses[i] = &CampaignResponse{
			Campaign:    campaign,
			Statistics:  toCampaignStatistics(stats),
			ActiveJobs:  countActiveJobs(campaign),
			TotalJobs:   countTotalJobs(campaign),
			HealthScore: calculateHealthScore(campaign, stats),
		}
	}

	// Calculate pagination metadata
	totalCount := len(campaigns) // In production, get total count from DB
	paginationMeta := &PaginationMeta{
		Page:       pagination.Page,
		PageSize:   pagination.PageSize,
		TotalPages: (totalCount + pagination.PageSize - 1) / pagination.PageSize,
		TotalItems: int64(totalCount),
		HasNext:    pagination.Page*pagination.PageSize < totalCount,
		HasPrev:    pagination.Page > 1,
	}

	writeSuccess(w, http.StatusOK, responses, nil, paginationMeta)
}

// GetCampaign retrieves a specific campaign
// @Summary Get campaign details
// @Description Get detailed information about a specific campaign
// @Tags campaigns
// @Accept json
// @Produce json
// @Param id path string true "Campaign ID"
// @Success 200 {object} SuccessResponse{data=CampaignResponse}
// @Failure 404 {object} ErrorResponse
// @Failure 500 {object} ErrorResponse
// @Router /api/v2/campaigns/{id} [get]
func (h *Handler) GetCampaign(w http.ResponseWriter, r *http.Request) {
	logger := getLogger(r.Context())

	// Validate campaign ID
	campaignID, err := validateCampaignID(r)
	if err != nil {
		writeError(w, http.StatusBadRequest, "INVALID_ID", "Invalid campaign ID", err)
		return
	}

	// Get campaign
	campaign, err := h.campaignService.Get(r.Context(), campaignID)
	if err != nil {
		if err == common.ErrCampaignNotFound {
			writeError(w, http.StatusNotFound, "NOT_FOUND", "Campaign not found", err)
		} else {
			logger.WithError(err).Error("Failed to get campaign")
			writeError(w, http.StatusInternalServerError, "GET_FAILED", "Failed to get campaign", err)
		}
		return
	}

	// Get statistics
	stats, _ := h.campaignService.GetStatistics(r.Context(), campaignID)

	// Build response
	response := &CampaignResponse{
		Campaign:    campaign,
		Statistics:  toCampaignStatistics(stats),
		ActiveJobs:  countActiveJobs(campaign),
		TotalJobs:   countTotalJobs(campaign),
		HealthScore: calculateHealthScore(campaign, stats),
	}

	writeSuccess(w, http.StatusOK, response, nil, nil)
}

// UpdateCampaign updates a campaign
// @Summary Update campaign
// @Description Update campaign properties using PATCH semantics
// @Tags campaigns
// @Accept json
// @Produce json
// @Param id path string true "Campaign ID"
// @Param updates body UpdateCampaignRequest true "Campaign updates"
// @Success 200 {object} SuccessResponse{data=CampaignResponse}
// @Failure 400 {object} ErrorResponse
// @Failure 404 {object} ErrorResponse
// @Failure 500 {object} ErrorResponse
// @Router /api/v2/campaigns/{id} [patch]
func (h *Handler) UpdateCampaign(w http.ResponseWriter, r *http.Request) {
	logger := getLogger(r.Context())

	// Validate campaign ID
	campaignID, err := validateCampaignID(r)
	if err != nil {
		writeError(w, http.StatusBadRequest, "INVALID_ID", "Invalid campaign ID", err)
		return
	}

	// Parse request
	var req UpdateCampaignRequest
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		writeError(w, http.StatusBadRequest, "INVALID_REQUEST", "Invalid request body", err)
		return
	}

	// Validate request
	if err := h.validator.ValidateStruct(&req); err != nil {
		writeError(w, http.StatusBadRequest, "VALIDATION_FAILED", "Request validation failed", err)
		return
	}

	// Build updates
	updates := common.CampaignUpdates{
		Name:        req.Name,
		Description: req.Description,
		// Status:       req.Status, // TODO: Handle status conversion
		AutoRestart:  req.AutoRestart,
		MaxDuration:  req.MaxDuration,
		MaxJobs:      req.MaxJobs,
		SharedCorpus: req.SharedCorpus,
		Tags:         req.Tags,
	}

	// Update campaign
	if err := h.campaignService.Update(r.Context(), campaignID, updates); err != nil {
		if err == common.ErrCampaignNotFound {
			writeError(w, http.StatusNotFound, "NOT_FOUND", "Campaign not found", err)
		} else {
			logger.WithError(err).Error("Failed to update campaign")
			writeError(w, http.StatusInternalServerError, "UPDATE_FAILED", "Failed to update campaign", err)
		}
		return
	}

	// Get updated campaign
	campaign, _ := h.campaignService.Get(r.Context(), campaignID)
	stats, _ := h.campaignService.GetStatistics(r.Context(), campaignID)

	// Build response
	response := &CampaignResponse{
		Campaign:    campaign,
		Statistics:  toCampaignStatistics(stats),
		ActiveJobs:  countActiveJobs(campaign),
		TotalJobs:   countTotalJobs(campaign),
		HealthScore: calculateHealthScore(campaign, stats),
	}

	// Broadcast update
	h.broadcastCampaignEvent("campaign_updated", campaignID, updates)

	writeSuccess(w, http.StatusOK, response, nil, nil)
}

// DeleteCampaign deletes a campaign
// @Summary Delete campaign
// @Description Delete a campaign and all associated resources
// @Tags campaigns
// @Accept json
// @Produce json
// @Param id path string true "Campaign ID"
// @Success 204 "No Content"
// @Failure 404 {object} ErrorResponse
// @Failure 409 {object} ErrorResponse
// @Failure 500 {object} ErrorResponse
// @Router /api/v2/campaigns/{id} [delete]
func (h *Handler) DeleteCampaign(w http.ResponseWriter, r *http.Request) {
	logger := getLogger(r.Context())

	// Validate campaign ID
	campaignID, err := validateCampaignID(r)
	if err != nil {
		writeError(w, http.StatusBadRequest, "INVALID_ID", "Invalid campaign ID", err)
		return
	}

	// Delete campaign
	if err := h.campaignService.Delete(r.Context(), campaignID); err != nil {
		if err == common.ErrCampaignNotFound {
			writeError(w, http.StatusNotFound, "NOT_FOUND", "Campaign not found", err)
		} else if strings.Contains(err.Error(), "active") {
			writeError(w, http.StatusConflict, "CAMPAIGN_ACTIVE", "Cannot delete active campaign", err)
		} else {
			logger.WithError(err).Error("Failed to delete campaign")
			writeError(w, http.StatusInternalServerError, "DELETE_FAILED", "Failed to delete campaign", err)
		}
		return
	}

	// Broadcast deletion
	h.broadcastCampaignEvent("campaign_deleted", campaignID, nil)

	w.WriteHeader(http.StatusNoContent)
}

// RestartCampaign restarts a campaign
// @Summary Restart campaign
// @Description Restart a completed or failed campaign
// @Tags campaigns
// @Accept json
// @Produce json
// @Param id path string true "Campaign ID"
// @Success 200 {object} SuccessResponse{data=CampaignResponse}
// @Failure 400 {object} ErrorResponse
// @Failure 404 {object} ErrorResponse
// @Failure 409 {object} ErrorResponse
// @Failure 500 {object} ErrorResponse
// @Router /api/v2/campaigns/{id}/restart [post]
func (h *Handler) RestartCampaign(w http.ResponseWriter, r *http.Request) {
	logger := getLogger(r.Context())

	// Validate campaign ID
	campaignID, err := validateCampaignID(r)
	if err != nil {
		writeError(w, http.StatusBadRequest, "INVALID_ID", "Invalid campaign ID", err)
		return
	}

	// Restart campaign
	if err := h.campaignService.RestartCampaign(r.Context(), campaignID); err != nil {
		if err == common.ErrCampaignNotFound {
			writeError(w, http.StatusNotFound, "NOT_FOUND", "Campaign not found", err)
		} else if strings.Contains(err.Error(), "status") {
			writeError(w, http.StatusConflict, "INVALID_STATUS", "Campaign cannot be restarted in current status", err)
		} else {
			logger.WithError(err).Error("Failed to restart campaign")
			writeError(w, http.StatusInternalServerError, "RESTART_FAILED", "Failed to restart campaign", err)
		}
		return
	}

	// Get updated campaign
	campaign, _ := h.campaignService.Get(r.Context(), campaignID)
	stats, _ := h.campaignService.GetStatistics(r.Context(), campaignID)

	// Build response
	response := &CampaignResponse{
		Campaign:    campaign,
		Statistics:  toCampaignStatistics(stats),
		ActiveJobs:  countActiveJobs(campaign),
		TotalJobs:   countTotalJobs(campaign),
		HealthScore: calculateHealthScore(campaign, stats),
	}

	// Broadcast restart
	h.broadcastCampaignEvent("campaign_restarted", campaignID, nil)

	writeSuccess(w, http.StatusOK, response, nil, nil)
}

// GetCampaignStats retrieves campaign statistics
// @Summary Get campaign statistics
// @Description Get detailed statistics for a campaign
// @Tags campaigns
// @Accept json
// @Produce json
// @Param id path string true "Campaign ID"
// @Success 200 {object} SuccessResponse{data=CampaignStatistics}
// @Failure 404 {object} ErrorResponse
// @Failure 500 {object} ErrorResponse
// @Router /api/v2/campaigns/{id}/stats [get]
func (h *Handler) GetCampaignStats(w http.ResponseWriter, r *http.Request) {
	logger := getLogger(r.Context())

	// Validate campaign ID
	campaignID, err := validateCampaignID(r)
	if err != nil {
		writeError(w, http.StatusBadRequest, "INVALID_ID", "Invalid campaign ID", err)
		return
	}

	// Get statistics
	stats, err := h.campaignService.GetStatistics(r.Context(), campaignID)
	if err != nil {
		if err == common.ErrCampaignNotFound {
			writeError(w, http.StatusNotFound, "NOT_FOUND", "Campaign not found", err)
		} else {
			logger.WithError(err).Error("Failed to get campaign statistics")
			writeError(w, http.StatusInternalServerError, "GET_STATS_FAILED", "Failed to get campaign statistics", err)
		}
		return
	}

	writeSuccess(w, http.StatusOK, toCampaignStatistics(stats), nil, nil)
}

// GetCampaignTimeline retrieves campaign timeline
// @Summary Get campaign timeline
// @Description Get timeline of events for a campaign
// @Tags campaigns
// @Accept json
// @Produce json
// @Param id path string true "Campaign ID"
// @Param limit query int false "Limit number of events" default(100)
// @Success 200 {object} SuccessResponse{data=[]CampaignTimelineEntry}
// @Failure 404 {object} ErrorResponse
// @Failure 500 {object} ErrorResponse
// @Router /api/v2/campaigns/{id}/timeline [get]
func (h *Handler) GetCampaignTimeline(w http.ResponseWriter, r *http.Request) {
	logger := getLogger(r.Context())

	// Validate campaign ID
	campaignID, err := validateCampaignID(r)
	if err != nil {
		writeError(w, http.StatusBadRequest, "INVALID_ID", "Invalid campaign ID", err)
		return
	}

	// Parse limit
	limit, err := validateLimit(r.URL.Query().Get("limit"), 100, 1000)
	if err != nil {
		writeError(w, http.StatusBadRequest, "INVALID_LIMIT", "Invalid limit parameter", err)
		return
	}

	// Get campaign to verify it exists
	campaign, err := h.campaignService.Get(r.Context(), campaignID)
	if err != nil {
		if err == common.ErrCampaignNotFound {
			writeError(w, http.StatusNotFound, "NOT_FOUND", "Campaign not found", err)
		} else {
			logger.WithError(err).Error("Failed to get campaign")
			writeError(w, http.StatusInternalServerError, "GET_FAILED", "Failed to get campaign", err)
		}
		return
	}

	// Build timeline
	timeline := buildCampaignTimeline(campaign, limit)

	writeSuccess(w, http.StatusOK, timeline, nil, nil)
}

// UploadCampaignBinary handles binary uploads for a campaign
// @Summary Upload campaign binary
// @Description Upload a target binary for the campaign
// @Tags campaigns
// @Accept multipart/form-data
// @Produce json
// @Param id path string true "Campaign ID"
// @Param binary formData file true "Binary file"
// @Success 200 {object} SuccessResponse
// @Failure 400 {object} ErrorResponse
// @Failure 404 {object} ErrorResponse
// @Failure 413 {object} ErrorResponse
// @Failure 500 {object} ErrorResponse
// @Router /api/v2/campaigns/{id}/binary [post]
func (h *Handler) UploadCampaignBinary(w http.ResponseWriter, r *http.Request) {
	logger := getLogger(r.Context())

	// Validate campaign ID
	campaignID, err := validateCampaignID(r)
	if err != nil {
		writeError(w, http.StatusBadRequest, "INVALID_ID", "Invalid campaign ID", err)
		return
	}

	// Parse multipart form (10MB max)
	if err := r.ParseMultipartForm(10 << 20); err != nil {
		writeError(w, http.StatusBadRequest, "PARSE_FAILED", "Failed to parse multipart form", err)
		return
	}

	// Get file
	file, header, err := r.FormFile("binary")
	if err != nil {
		writeError(w, http.StatusBadRequest, "NO_FILE", "No binary file provided", err)
		return
	}
	defer file.Close()

	// Check file size (100MB max)
	if header.Size > 100<<20 {
		writeError(w, http.StatusRequestEntityTooLarge, "FILE_TOO_LARGE", "Binary file too large (max 100MB)", nil)
		return
	}

	// Upload binary (this method needs to be implemented separately)
	// For now, return a placeholder response
	binaryInfo := struct {
		Hash string
	}{Hash: "placeholder-hash"}
	_ = campaignID // Use campaignID to avoid unused variable error
	err = nil      // TODO: Implement binary upload
	if err != nil {
		if err == common.ErrCampaignNotFound {
			writeError(w, http.StatusNotFound, "NOT_FOUND", "Campaign not found", err)
		} else {
			logger.WithError(err).Error("Failed to upload binary")
			writeError(w, http.StatusInternalServerError, "UPLOAD_FAILED", "Failed to upload binary", err)
		}
		return
	}

	response := map[string]interface{}{
		"filename": header.Filename,
		"size":     header.Size,
		"hash":     binaryInfo.Hash,
		"uploaded": true,
	}

	writeSuccess(w, http.StatusOK, response, nil, nil)
}

// UploadCampaignCorpus handles corpus uploads for a campaign
// @Summary Upload campaign corpus
// @Description Upload corpus files for the campaign
// @Tags campaigns
// @Accept multipart/form-data
// @Produce json
// @Param id path string true "Campaign ID"
// @Param corpus formData file true "Corpus archive (zip/tar.gz)"
// @Success 200 {object} SuccessResponse
// @Failure 400 {object} ErrorResponse
// @Failure 404 {object} ErrorResponse
// @Failure 413 {object} ErrorResponse
// @Failure 500 {object} ErrorResponse
// @Router /api/v2/campaigns/{id}/corpus [post]
func (h *Handler) UploadCampaignCorpus(w http.ResponseWriter, r *http.Request) {
	logger := getLogger(r.Context())

	// Validate campaign ID
	campaignID, err := validateCampaignID(r)
	if err != nil {
		writeError(w, http.StatusBadRequest, "INVALID_ID", "Invalid campaign ID", err)
		return
	}

	// Parse multipart form (50MB max)
	if err := r.ParseMultipartForm(50 << 20); err != nil {
		writeError(w, http.StatusBadRequest, "PARSE_FAILED", "Failed to parse multipart form", err)
		return
	}

	// Get file
	file, header, err := r.FormFile("corpus")
	if err != nil {
		writeError(w, http.StatusBadRequest, "NO_FILE", "No corpus file provided", err)
		return
	}
	defer file.Close()

	// Check file size (500MB max)
	if header.Size > 500<<20 {
		writeError(w, http.StatusRequestEntityTooLarge, "FILE_TOO_LARGE", "Corpus file too large (max 500MB)", nil)
		return
	}

	// Upload corpus (this method needs to be implemented separately)
	// For now, return a placeholder response
	corpusInfo := struct {
		FileCount int
	}{FileCount: 0}
	_ = campaignID // Use campaignID to avoid unused variable error
	err = nil      // TODO: Implement corpus upload
	if err != nil {
		if err == common.ErrCampaignNotFound {
			writeError(w, http.StatusNotFound, "NOT_FOUND", "Campaign not found", err)
		} else {
			logger.WithError(err).Error("Failed to upload corpus")
			writeError(w, http.StatusInternalServerError, "UPLOAD_FAILED", "Failed to upload corpus", err)
		}
		return
	}

	response := map[string]interface{}{
		"filename":    header.Filename,
		"size":        header.Size,
		"files_count": corpusInfo.FileCount,
		"uploaded":    true,
	}

	writeSuccess(w, http.StatusOK, response, nil, nil)
}

// Helper functions

func toCampaignStatistics(stats *common.CampaignStats) *CampaignStatistics {
	if stats == nil {
		return nil
	}

	return &CampaignStatistics{
		TotalCrashes:     int64(stats.TotalCrashes),
		UniqueCrashes:    int64(stats.UniqueCrashes),
		TotalCoverage:    float64(stats.TotalCoverage),
		CorpusSize:       stats.CorpusSize,
		ExecutionsPerSec: 0, // Calculate from job metrics
		LastUpdated:      stats.LastUpdated,
	}
}

