func buildCampaignTimeline(campaign *common.Campaign, limit int) []CampaignTimelineEntry {
	timeline := []CampaignTimelineEntry{
		{
			Timestamp:   campaign.CreatedAt,
			EventType:   "campaign_created",
			Description: "Campaign created",
			Data: map[string]interface{}{
				"name":   campaign.Name,
				"status": campaign.Status,
			},
		},
	}

	// Add more timeline events from various sources
	// - Job events
	// - Crash discoveries
	// - Coverage milestones
	// - Status changes

	// Limit results
	if len(timeline) > limit {
		timeline = timeline[:limit]
	}

	return timeline
}

