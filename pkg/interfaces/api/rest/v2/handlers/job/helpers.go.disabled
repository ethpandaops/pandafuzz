package job

import (
	"context"
	"encoding/json"
	"errors"
	"fmt"
	"net/http"
	"strconv"
	"strings"
	"time"

	"github.com/ethpandaops/pandafuzz/pkg/common"
	"github.com/ethpandaops/pandafuzz/pkg/service"
	"github.com/go-playground/validator/v10"
	"github.com/gorilla/mux"
	"github.com/sirupsen/logrus"
)

// Validator provides request validation
type Validator struct {
	validate *validator.Validate
}

// NewValidator creates a new validator instance
func NewValidator() *Validator {
	v := validator.New()

	// Register custom validators
	v.RegisterValidation("job_status", validateJobStatus)
	v.RegisterValidation("fuzzer", validateFuzzer)

	return &Validator{
		validate: v,
	}
}

// ValidateStruct validates a struct
func (v *Validator) ValidateStruct(s interface{}) error {
	return v.validate.Struct(s)
}

func validateJobStatus(fl validator.FieldLevel) bool {
	status := fl.Field().String()
	validStatuses := []string{"pending", "assigned", "running", "completed", "failed", "timed_out", "cancelled"}
	for _, valid := range validStatuses {
		if status == valid {
			return true
		}
	}
	return false
}

func validateFuzzer(fl validator.FieldLevel) bool {
	fuzzer := fl.Field().String()
	validFuzzers := []string{"afl++", "libfuzzer", "honggfuzz"}
	for _, valid := range validFuzzers {
		if fuzzer == valid {
			return true
		}
	}
	return false
}

// Request/Response types

type CreateJobRequest struct {
	Name              string            `json:"name" validate:"required,min=3,max=100"`
	CampaignID        string            `json:"campaign_id" validate:"required"`
	TargetBinary      string            `json:"target_binary"`
	Duration          time.Duration     `json:"duration" validate:"required,min=60s"`
	Arguments         []string          `json:"arguments"`
	Environment       map[string]string `json:"environment"`
	Fuzzer            string            `json:"fuzzer" validate:"required,fuzzer"`
	MaxCrashes        int               `json:"max_crashes" validate:"min=1"`
	MaxTotalTime      time.Duration     `json:"max_total_time"`
	RequiredCPU       int               `json:"required_cpu" validate:"min=1"`
	RequiredMemory    int64             `json:"required_memory" validate:"min=1048576"`
	CorpusID          string            `json:"corpus_id,omitempty"`
	CollectionID      string            `json:"collection_id,omitempty"`
	UseCampaignCorpus bool              `json:"use_campaign_corpus,omitempty"`
}

type UpdateJobRequest struct {
	Status       *string `json:"status,omitempty" validate:"omitempty,job_status"`
	Priority     *int    `json:"priority,omitempty" validate:"omitempty,min=0,max=10"`
	MaxCrashes   *int    `json:"max_crashes,omitempty" validate:"omitempty,min=1"`
	MaxTotalTime *string `json:"max_total_time,omitempty"`
}

type JobResponse struct {
	*common.Job
	Progress      float64       `json:"progress"`
	TimeRemaining time.Duration `json:"time_remaining,omitempty"`
	Statistics    *JobStats     `json:"statistics,omitempty"`
	BotInfo       *BotInfo      `json:"bot_info,omitempty"`
}

type JobStats struct {
	CrashesFound     int64         `json:"crashes_found"`
	UniqueCrashes    int64         `json:"unique_crashes"`
	CorpusSize       int64         `json:"corpus_size"`
	CoveragePercent  float64       `json:"coverage_percent"`
	ExecutionsTotal  int64         `json:"executions_total"`
	ExecutionsPerSec float64       `json:"executions_per_sec"`
	Duration         time.Duration `json:"duration"`
}

type BotInfo struct {
	ID       string `json:"id"`
	Name     string `json:"name"`
	Hostname string `json:"hostname"`
}

type JobCrashResponse struct {
	*common.CrashResult
	StackTrace *common.StackTrace `json:"stack_trace,omitempty"`
}

type PaginationParams struct {
	Page     int    `json:"page"`
	PageSize int    `json:"page_size"`
	Sort     string `json:"sort"`
	Order    string `json:"order"`
}

type PaginationMeta struct {
	Page       int   `json:"page"`
	PageSize   int   `json:"page_size"`
	TotalPages int   `json:"total_pages"`
	TotalItems int64 `json:"total_items"`
	HasNext    bool  `json:"has_next"`
	HasPrev    bool  `json:"has_prev"`
}

// Helper functions

func getLogger(ctx context.Context) logrus.FieldLogger {
	if logger, ok := ctx.Value("logger").(logrus.FieldLogger); ok {
		return logger
	}
	return logrus.StandardLogger()
}

func writeJSON(w http.ResponseWriter, statusCode int, data interface{}) {
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(statusCode)
	json.NewEncoder(w).Encode(data)
}

func writeError(w http.ResponseWriter, statusCode int, code, message string, err error) {
	response := map[string]interface{}{
		"error": map[string]interface{}{
			"code":       code,
			"message":    message,
			"request_id": w.Header().Get("X-Request-ID"),
		},
	}

	if err != nil && statusCode >= 500 {
		response["error"].(map[string]interface{})["details"] = err.Error()
	}

	writeJSON(w, statusCode, response)
}

func writeSuccess(w http.ResponseWriter, statusCode int, data interface{}, meta interface{}, pagination *PaginationMeta) {
	response := map[string]interface{}{
		"data":       data,
		"request_id": w.Header().Get("X-Request-ID"),
		"timestamp":  time.Now(),
	}

	if meta != nil {
		response["meta"] = meta
	}

	if pagination != nil {
		response["pagination"] = pagination
	}

	writeJSON(w, statusCode, response)
}

// Validation helpers

func validateJobID(r *http.Request) (string, error) {
	vars := mux.Vars(r)
	id := vars["id"]
	if id == "" {
		return "", errors.New("job ID is required")
	}
	if len(id) < 3 {
		return "", errors.New("job ID is too short")
	}
	return id, nil
}

func parsePaginationParams(r *http.Request) (*PaginationParams, error) {
	params := &PaginationParams{
		Page:     1,
		PageSize: 20,
		Order:    "asc",
	}

	// Parse page
	if pageStr := r.URL.Query().Get("page"); pageStr != "" {
		page, err := strconv.Atoi(pageStr)
		if err != nil || page < 1 {
			return nil, fmt.Errorf("invalid page parameter: %s", pageStr)
		}
		params.Page = page
	}

	// Parse page size
	if pageSizeStr := r.URL.Query().Get("page_size"); pageSizeStr != "" {
		pageSize, err := strconv.Atoi(pageSizeStr)
		if err != nil || pageSize < 1 || pageSize > 100 {
			return nil, fmt.Errorf("invalid page_size parameter: %s (must be 1-100)", pageSizeStr)
		}
		params.PageSize = pageSize
	}

	// Parse sort field
	if sort := r.URL.Query().Get("sort"); sort != "" {
		params.Sort = sort
	}

	// Parse order
	if order := r.URL.Query().Get("order"); order != "" {
		order = strings.ToLower(order)
		if order != "asc" && order != "desc" {
			return nil, fmt.Errorf("invalid order parameter: %s (must be asc or desc)", order)
		}
		params.Order = order
	}

	return params, nil
}

func toJobStats(stats *service.JobStats) *JobStats {
	if stats == nil {
		return nil
	}

	return &JobStats{
		CrashesFound:     stats.CrashesFound,
		UniqueCrashes:    stats.UniqueCrashes,
		CorpusSize:       stats.CorpusSize,
		CoveragePercent:  stats.CoveragePercent,
		ExecutionsTotal:  stats.ExecutionsTotal,
		ExecutionsPerSec: stats.ExecutionsPerSec,
		Duration:         stats.Duration,
	}
}
