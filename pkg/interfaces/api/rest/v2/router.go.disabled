package v2

import (
	"net/http"
	"time"

	"github.com/ethpandaops/pandafuzz/pkg/application/analytics"
	analyticsAdapter "github.com/ethpandaops/pandafuzz/pkg/infrastructure/analytics"
	"github.com/ethpandaops/pandafuzz/pkg/infrastructure/storage/abstraction"
	v2analytics "github.com/ethpandaops/pandafuzz/pkg/interfaces/api/rest/v2/handlers/analytics"
	"github.com/ethpandaops/pandafuzz/pkg/interfaces/api/rest/v2/handlers/bot"
	"github.com/ethpandaops/pandafuzz/pkg/interfaces/api/rest/v2/handlers/campaign"
	"github.com/ethpandaops/pandafuzz/pkg/interfaces/api/rest/v2/handlers/job"
	"github.com/ethpandaops/pandafuzz/pkg/service"
	"github.com/gorilla/mux"
	"github.com/prometheus/client_golang/prometheus"
	"github.com/sirupsen/logrus"
	httpSwagger "github.com/swaggo/http-swagger"
)

// RouterConfig contains configuration for the V2 router
type RouterConfig struct {
	// Services
	BotService      service.BotService
	JobService      service.JobService
	CampaignService service.CampaignService
	ResultService   service.ResultService
	CorpusService   service.CorpusService
	Storage         abstraction.Driver

	// Logger
	Logger logrus.FieldLogger

	// Middleware configuration
	EnableCORS      bool
	AllowedOrigins  []string
	EnableMetrics   bool
	EnableRateLimit bool
	RateLimitPerMin int

	// Timeouts
	RequestTimeout string
	ReadTimeout    time.Duration
	WriteTimeout   time.Duration

	// Circuit breaker configuration
	CircuitBreakerEnabled     bool
	CircuitBreakerThreshold   float64
	CircuitBreakerMaxRequests uint32

	// Prometheus registry (optional)
	PrometheusRegistry *prometheus.Registry
}

// Router handles V2 API routing
type Router struct {
	config     *RouterConfig
	middleware *Middleware
	logger     logrus.FieldLogger

	// Handlers
	campaignHandler  *campaign.Handler
	botHandler       *bot.Handler
	jobHandler       *job.Handler
	analyticsHandler *v2analytics.Handler
}

// NewRouter creates a new V2 router
func NewRouter(config *RouterConfig) *Router {
	if config.Logger == nil {
		config.Logger = logrus.New()
	}

	// Create middleware
	middlewareConfig := MiddlewareConfig{
		Logger:                    config.Logger,
		EnableCORS:                config.EnableCORS,
		AllowedOrigins:            config.AllowedOrigins,
		EnableMetrics:             config.EnableMetrics,
		EnableRateLimit:           config.EnableRateLimit,
		RateLimitPerMin:           config.RateLimitPerMin,
		CircuitBreakerEnabled:     config.CircuitBreakerEnabled,
		CircuitBreakerThreshold:   config.CircuitBreakerThreshold,
		CircuitBreakerMaxRequests: config.CircuitBreakerMaxRequests,
	}

	if config.RequestTimeout != "" {
		if timeout, err := time.ParseDuration(config.RequestTimeout); err == nil {
			middlewareConfig.RequestTimeout = timeout
		}
	}

	if config.PrometheusRegistry != nil {
		middlewareConfig.PrometheusRegistry = config.PrometheusRegistry
	}

	middleware := NewMiddleware(middlewareConfig)

	// Create analytics service using the adapter
	analyticsService := createAnalyticsService(config)

	// Create handlers
	campaignHandler := campaign.NewHandler(config.CampaignService, config.Logger)
	botHandler := bot.NewHandler(config.BotService, config.Logger)
	jobHandler := job.NewHandler(config.JobService, config.Logger)
	analyticsHandler := v2analytics.NewHandler(analyticsService, config.Logger)

	return &Router{
		config:           config,
		middleware:       middleware,
		logger:           config.Logger,
		campaignHandler:  campaignHandler,
		botHandler:       botHandler,
		jobHandler:       jobHandler,
		analyticsHandler: analyticsHandler,
	}
}

// SetupRoutes configures all V2 API routes
func (r *Router) SetupRoutes(router *mux.Router) {
	// Apply global middleware
	router.Use(r.middleware.RequestIDMiddleware)
	router.Use(r.middleware.LoggingMiddleware)

	if r.config.EnableMetrics {
		router.Use(r.middleware.MetricsMiddleware)
	}

	if r.config.CircuitBreakerEnabled {
		router.Use(r.middleware.CircuitBreakerMiddleware)
	}

	if r.config.EnableRateLimit {
		router.Use(r.middleware.RateLimitMiddleware)
	}

	if r.config.EnableCORS {
		router.Use(r.middleware.CORSMiddleware)
	}

	router.Use(r.middleware.TimeoutMiddleware)
	router.Use(r.middleware.RecoveryMiddleware)

	// API documentation
	if r.config.Logger != nil {
		router.PathPrefix("/swagger/").Handler(httpSwagger.Handler(
			httpSwagger.URL("/api/v2/swagger/doc.json"),
			httpSwagger.DeepLinking(true),
			httpSwagger.DocExpansion("none"),
			httpSwagger.DomID("#swagger-ui"),
		))
	}

	// Health check endpoint
	router.HandleFunc("/health", r.handleHealthCheck).Methods("GET", "HEAD")

	// Version endpoint
	router.HandleFunc("/version", r.handleVersion).Methods("GET")

	// Campaign routes
	campaigns := router.PathPrefix("/campaigns").Subrouter()
	r.campaignHandler.RegisterRoutes(campaigns)

	// Bot routes
	bots := router.PathPrefix("/bots").Subrouter()
	r.botHandler.RegisterRoutes(bots)

	// Job routes
	jobs := router.PathPrefix("/jobs").Subrouter()
	r.jobHandler.RegisterRoutes(jobs)

	// Analytics routes
	analytics := router.PathPrefix("/analytics").Subrouter()
	r.analyticsHandler.RegisterRoutes(analytics)

	// WebSocket endpoint for real-time updates
	router.HandleFunc("/ws", r.handleWebSocket).Methods("GET")

	// Catch-all for undefined routes
	router.NotFoundHandler = http.HandlerFunc(r.handleNotFound)
	router.MethodNotAllowedHandler = http.HandlerFunc(r.handleMethodNotAllowed)
}

// handleHealthCheck returns the health status of the API
// @Summary Health check
// @Description Check if the API is healthy and responding
// @Tags system
// @Produce json
// @Success 200 {object} map[string]interface{}
// @Router /api/v2/health [get]
func (r *Router) handleHealthCheck(w http.ResponseWriter, req *http.Request) {
	health := map[string]interface{}{
		"status":    "healthy",
		"timestamp": time.Now().UTC(),
		"version":   "2.0.0",
		"services": map[string]string{
			"bot":      getServiceStatus(r.config.BotService),
			"job":      getServiceStatus(r.config.JobService),
			"campaign": getServiceStatus(r.config.CampaignService),
			"storage":  getStorageStatus(r.config.Storage),
		},
	}

	WriteJSON(w, http.StatusOK, health)
}

// handleVersion returns API version information
// @Summary Get API version
// @Description Get detailed version information about the API
// @Tags system
// @Produce json
// @Success 200 {object} map[string]interface{}
// @Router /api/v2/version [get]
func (r *Router) handleVersion(w http.ResponseWriter, req *http.Request) {
	version := map[string]interface{}{
		"api_version": "2.0.0",
		"build_time":  time.Now().UTC(), // In production, use actual build time
		"features": []string{
			"pagination",
			"filtering",
			"websocket",
			"sse",
			"circuit-breaker",
			"rate-limiting",
			"cors",
		},
		"supported_formats": []string{
			"application/json",
			"text/csv",
			"text/html",
		},
	}

	WriteJSON(w, http.StatusOK, version)
}

// handleWebSocket handles WebSocket connections for real-time updates
// @Summary WebSocket endpoint
// @Description Connect via WebSocket for real-time updates
// @Tags system
// @Success 101 "Switching Protocols"
// @Failure 400 {object} ErrorResponse
// @Router /api/v2/ws [get]
func (r *Router) handleWebSocket(w http.ResponseWriter, req *http.Request) {
	// WebSocket upgrade would be handled here
	// This is a placeholder - actual implementation would use gorilla/websocket
	WriteError(w, http.StatusNotImplemented, "WEBSOCKET_NOT_IMPLEMENTED", "WebSocket support not yet implemented", nil)
}

// handleNotFound handles requests to undefined routes
func (r *Router) handleNotFound(w http.ResponseWriter, req *http.Request) {
	WriteError(w, http.StatusNotFound, "ROUTE_NOT_FOUND", "The requested endpoint does not exist", nil)
}

// handleMethodNotAllowed handles requests with unsupported methods
func (r *Router) handleMethodNotAllowed(w http.ResponseWriter, req *http.Request) {
	WriteError(w, http.StatusMethodNotAllowed, "METHOD_NOT_ALLOWED", "The requested method is not allowed for this endpoint", nil)
}

// createAnalyticsService creates an analytics service using the adapter pattern
func createAnalyticsService(config *RouterConfig) analytics.AnalyticsService {
	// Create the adapter
	adapter := analyticsAdapter.NewServiceAdapter(
		config.Storage,
		config.JobService,
		config.CampaignService,
		config.Logger,
	)

	// Create the analytics service with all components
	return analytics.NewAnalyticsService(
		adapter, // storage
		adapter, // job provider
		adapter, // campaign provider
		analytics.NewCoverageAnalyzer(config.Logger),    // coverage analyzer
		analytics.NewCrashAnalyzer(config.Logger),       // crash analyzer
		analytics.NewPerformanceAnalyzer(config.Logger), // performance analyzer
		config.Logger,
	)
}

// getServiceStatus returns the status of a service
func getServiceStatus(service interface{}) string {
	if service == nil {
		return "unavailable"
	}
	// In production, could check actual service health
	return "healthy"
}

// getStorageStatus returns the status of storage
func getStorageStatus(storage abstraction.Driver) string {
	if storage == nil {
		return "unavailable"
	}
	// Could perform a simple health check
	return "healthy"
}

// Serve starts the V2 API server
func (r *Router) Serve(addr string) error {
	router := mux.NewRouter()

	// Mount V2 API at /api/v2
	v2Router := router.PathPrefix("/api/v2").Subrouter()
	r.SetupRoutes(v2Router)

	// Create HTTP server
	server := &http.Server{
		Addr:         addr,
		Handler:      router,
		ReadTimeout:  r.config.ReadTimeout,
		WriteTimeout: r.config.WriteTimeout,
		IdleTimeout:  120 * time.Second,
	}

	r.logger.WithField("addr", addr).Info("Starting V2 API server")
	return server.ListenAndServe()
}
