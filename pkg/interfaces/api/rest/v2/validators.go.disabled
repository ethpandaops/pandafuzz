package v2

import (
	"fmt"
	"net/http"
	"strconv"
	"strings"
	"time"

	"github.com/go-playground/validator/v10"
	"github.com/gorilla/mux"
)

// Validator provides request validation functionality
type Validator struct {
	validate *validator.Validate
}

// NewValidator creates a new validator instance
func NewValidator() *Validator {
	v := validator.New()

	// Register custom validators
	v.RegisterValidation("campaign_status", validateCampaignStatus)
	v.RegisterValidation("job_status", validateJobStatus)
	v.RegisterValidation("bot_status", validateBotStatus)
	v.RegisterValidation("fuzzer", validateFuzzer)

	return &Validator{
		validate: v,
	}
}

// ValidateStruct validates a struct against its validation tags
func (v *Validator) ValidateStruct(s interface{}) error {
	return v.validate.Struct(s)
}

// ParsePaginationParams extracts and validates pagination parameters from request
func ParsePaginationParams(r *http.Request) (*PaginationParams, error) {
	params := &PaginationParams{
		Page:     1,
		PageSize: 20,
		Order:    "asc",
	}

	// Parse page
	if pageStr := r.URL.Query().Get("page"); pageStr != "" {
		page, err := strconv.Atoi(pageStr)
		if err != nil || page < 1 {
			return nil, fmt.Errorf("invalid page parameter: %s", pageStr)
		}
		params.Page = page
	}

	// Parse page size
	if pageSizeStr := r.URL.Query().Get("page_size"); pageSizeStr != "" {
		pageSize, err := strconv.Atoi(pageSizeStr)
		if err != nil || pageSize < 1 || pageSize > 100 {
			return nil, fmt.Errorf("invalid page_size parameter: %s (must be 1-100)", pageSizeStr)
		}
		params.PageSize = pageSize
	}

	// Parse sort field
	if sort := r.URL.Query().Get("sort"); sort != "" {
		// Validate sort field based on context (would need to be extended)
		params.Sort = sort
	}

	// Parse order
	if order := r.URL.Query().Get("order"); order != "" {
		order = strings.ToLower(order)
		if order != "asc" && order != "desc" {
			return nil, fmt.Errorf("invalid order parameter: %s (must be asc or desc)", order)
		}
		params.Order = order
	}

	return params, nil
}

// ParseTimeRangeParams extracts and validates time range parameters
func ParseTimeRangeParams(r *http.Request) (*TimeRangeParams, error) {
	params := &TimeRangeParams{
		Interval: "hour", // Default interval
	}

	// Parse start time
	startStr := r.URL.Query().Get("start_time")
	if startStr != "" {
		startTime, err := time.Parse(time.RFC3339, startStr)
		if err != nil {
			return nil, fmt.Errorf("invalid start_time format: %v", err)
		}
		params.StartTime = startTime
	} else {
		// Default to 24 hours ago
		params.StartTime = time.Now().Add(-24 * time.Hour)
	}

	// Parse end time
	endStr := r.URL.Query().Get("end_time")
	if endStr != "" {
		endTime, err := time.Parse(time.RFC3339, endStr)
		if err != nil {
			return nil, fmt.Errorf("invalid end_time format: %v", err)
		}
		params.EndTime = endTime
	} else {
		// Default to now
		params.EndTime = time.Now()
	}

	// Validate time range
	if params.EndTime.Before(params.StartTime) {
		return nil, fmt.Errorf("end_time must be after start_time")
	}

	// Parse interval
	if interval := r.URL.Query().Get("interval"); interval != "" {
		validIntervals := []string{"minute", "hour", "day", "week", "month"}
		isValid := false
		for _, v := range validIntervals {
			if interval == v {
				isValid = true
				break
			}
		}
		if !isValid {
			return nil, fmt.Errorf("invalid interval: %s (must be one of: %s)", interval, strings.Join(validIntervals, ", "))
		}
		params.Interval = interval
	}

	return params, nil
}

// ValidateID validates that an ID parameter is present and valid
func ValidateID(vars map[string]string, paramName string) (string, error) {
	id := vars[paramName]
	if id == "" {
		return "", fmt.Errorf("%s is required", paramName)
	}

	// Add additional ID format validation if needed
	if len(id) < 3 {
		return "", fmt.Errorf("%s is too short", paramName)
	}

	return id, nil
}

// ValidateCampaignID validates a campaign ID from path parameters
func ValidateCampaignID(r *http.Request) (string, error) {
	vars := mux.Vars(r)
	return ValidateID(vars, "id")
}

// ValidateBotID validates a bot ID from path parameters
func ValidateBotID(r *http.Request) (string, error) {
	vars := mux.Vars(r)
	return ValidateID(vars, "id")
}

// ValidateJobID validates a job ID from path parameters
func ValidateJobID(r *http.Request) (string, error) {
	vars := mux.Vars(r)
	return ValidateID(vars, "id")
}

// ValidateCrashID validates a crash ID from path parameters
func ValidateCrashID(r *http.Request) (string, error) {
	vars := mux.Vars(r)
	return ValidateID(vars, "crash_id")
}

// Custom validator functions

func validateCampaignStatus(fl validator.FieldLevel) bool {
	status := fl.Field().String()
	validStatuses := []string{"pending", "running", "completed", "failed", "paused", "cancelled", "corpus_only"}
	for _, valid := range validStatuses {
		if status == valid {
			return true
		}
	}
	return false
}

func validateJobStatus(fl validator.FieldLevel) bool {
	status := fl.Field().String()
	validStatuses := []string{"pending", "assigned", "running", "completed", "failed", "timed_out", "cancelled"}
	for _, valid := range validStatuses {
		if status == valid {
			return true
		}
	}
	return false
}

func validateBotStatus(fl validator.FieldLevel) bool {
	status := fl.Field().String()
	validStatuses := []string{"registering", "idle", "busy", "timed_out", "failed"}
	for _, valid := range validStatuses {
		if status == valid {
			return true
		}
	}
	return false
}

func validateFuzzer(fl validator.FieldLevel) bool {
	fuzzer := fl.Field().String()
	validFuzzers := []string{"afl++", "libfuzzer", "honggfuzz"}
	for _, valid := range validFuzzers {
		if fuzzer == valid {
			return true
		}
	}
	return false
}

// ValidateQueryTags validates and parses tags from query string
func ValidateQueryTags(r *http.Request) ([]string, error) {
	tagsStr := r.URL.Query().Get("tags")
	if tagsStr == "" {
		return nil, nil
	}

	// Try to parse as JSON array first
	var tags []string
	if strings.HasPrefix(tagsStr, "[") {
		// JSON array format
		// In production, use json.Unmarshal
		tags = strings.Split(strings.Trim(tagsStr, "[]"), ",")
	} else {
		// Comma-separated format
		tags = strings.Split(tagsStr, ",")
	}

	// Clean and validate tags
	validTags := make([]string, 0, len(tags))
	for _, tag := range tags {
		tag = strings.TrimSpace(tag)
		tag = strings.Trim(tag, "\"'")
		if tag != "" {
			if len(tag) > 50 {
				return nil, fmt.Errorf("tag too long: %s (max 50 chars)", tag)
			}
			validTags = append(validTags, tag)
		}
	}

	return validTags, nil
}

// ValidateDuration validates and parses a duration string
func ValidateDuration(durationStr string) (time.Duration, error) {
	if durationStr == "" {
		return 0, fmt.Errorf("duration is required")
	}

	duration, err := time.ParseDuration(durationStr)
	if err != nil {
		return 0, fmt.Errorf("invalid duration format: %v", err)
	}

	if duration < time.Minute {
		return 0, fmt.Errorf("duration must be at least 1 minute")
	}

	if duration > 7*24*time.Hour {
		return 0, fmt.Errorf("duration cannot exceed 7 days")
	}

	return duration, nil
}

// ValidateLimit validates a limit parameter
func ValidateLimit(limitStr string, defaultLimit, maxLimit int) (int, error) {
	if limitStr == "" {
		return defaultLimit, nil
	}

	limit, err := strconv.Atoi(limitStr)
	if err != nil {
		return 0, fmt.Errorf("invalid limit: %s", limitStr)
	}

	if limit < 1 {
		return 0, fmt.Errorf("limit must be at least 1")
	}

	if limit > maxLimit {
		return 0, fmt.Errorf("limit cannot exceed %d", maxLimit)
	}

	return limit, nil
}

// ValidateOffset validates an offset parameter
func ValidateOffset(offsetStr string) (int, error) {
	if offsetStr == "" {
		return 0, nil
	}

	offset, err := strconv.Atoi(offsetStr)
	if err != nil {
		return 0, fmt.Errorf("invalid offset: %s", offsetStr)
	}

	if offset < 0 {
		return 0, fmt.Errorf("offset cannot be negative")
	}

	return offset, nil
}
